# =============================================================================
# DRAPE — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Frontend (Cloudflare Pages) — set at build time:
VITE_API_BASE_URL=https://your-app.onrender.com

# Backend (Render):
# ── Database ──
DATABASE_URL=postgresql://user:password@host:5432/drape

# ── Auth ──
JWT_SECRET=your-256-bit-random-secret-here
GOOGLE_CLIENT_ID=your-google-oauth-client-id

# ── AI Provider (OpenRouter preferred) ──
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://drape.app
OPENROUTER_APP_NAME=Drape

# ── Alternative AI Providers (fallback order) ──
# Groq:
GROQ_API_KEY=gsk-your-key-here
GROQ_MODEL=llama-3.1-8b-instant

# BlueMinds (legacy):
BLUEMINDS_API_KEY=sk-your-key-here
BLUEMINDS_BASE_URL=https://api.bluesminds.com/v1
BLUEMINDS_MODEL_ID=gpt-4o-mini

# OpenAI (direct):
OPENAI_API_KEY=sk-your-key-here

# ── Storage (GCS-compatible) ──
# Replit uses a built-in sidecar; on Render set these for external GCS:
GCS_BUCKET_NAME=drape-uploads
PUBLIC_OBJECT_SEARCH_PATHS=public/

# ── CORS ──
# Comma-separated list of allowed origins (besides default Cloudflare domains)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── WhatsApp ──
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_WHATSAPP_NUMBER=+14155238886

# ── Notifications ──
NOTIFICATION_EMAIL_FROM=noreply@drape.app

# ── Server ──
PORT=3000
NODE_ENV=production
LOG_LEVEL=info
